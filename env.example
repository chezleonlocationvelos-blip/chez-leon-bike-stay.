# Webhook Stripe : URL à déclarer dans Stripe → /api/stripe/webhook
# Événements à activer : checkout.session.completed, payment_intent.amount_capturable_updated, account.updated

# Emails (Resend) et rappels
APP_SECRET=            # openssl rand -base64 32  (chiffre la copie du lien client)
RESEND_API_KEY=
EMAIL_FROM=Chez Léon <reservation@votre-domaine.fr>
EMAIL_REPLY_TO=
CRON_SECRET=           # openssl rand -hex 32  (protège /api/cron/reminders)
